<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões de rede (sincronização com o servidor) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Câmera (cadastro de fotos pelo gestor) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Armazenamento (Android 9 e abaixo) — no 10+ usamos MediaStore/FileProvider -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- Boot: abrir o app automaticamente assim que o tablet ligar -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AchadosPerdidosApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AchadosPerdidos"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:immersive="true"
            android:launchMode="singleInstance"
            android:lockTaskMode="if_whitelisted"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true">

            <!-- Launcher padrão (aparece na lista de apps) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                HOME launcher: quando o app for Device Owner, o MainActivity
                chama addPersistentPreferredActivity para esta categoria,
                fazendo o tablet abrir o app sozinho ao apertar Home / no boot.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Device Admin / Device Owner.
            O permission BIND_DEVICE_ADMIN garante que só o sistema invoque o receiver.
            android:exported=true é obrigatório para o sistema enxergá-lo.
        -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.LOCK_TASK_ENTERING" />
                <action android:name="android.app.action.LOCK_TASK_EXITING" />
            </intent-filter>
        </receiver>

        <!-- Auto-start no boot (e LOCKED_BOOT_COMPLETED em devices com criptografia de arquivo) -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false"
            android:enabled="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!--
            FileProvider: necessário para compartilhar o Uri da foto com o intent da câmera
            no Android 7+ sem expor file:// diretamente.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

    </application>

</manifest>
