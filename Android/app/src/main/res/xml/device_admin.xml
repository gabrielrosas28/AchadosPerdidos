<?xml version="1.0" encoding="utf-8"?>
<!--
    Politicas declaradas pelo AdminReceiver.

    Sao as capacidades que o receiver pode usar enquanto Device Admin / Device Owner.
    Em quiosque de uso unico (single-use kiosk) essas sao as politicas necessarias
    para suportar todas as operacoes que fazemos em MainActivity (lock task,
    desligar status bar, etc) e prepara o terreno para futuras restricoes.
-->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />
        <expire-password />
        <encrypted-storage />
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
